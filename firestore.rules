rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.token.email != null
        && (request.auth.token.email == 'ifeadia21@gmail.com'
          || (exists(/databases/$(database)/documents/config/admins)
            && request.auth.token.email in get(/databases/$(database)/documents/config/admins).data.emails));
    }

    function hasSixDistinctFeaturedProductIds(ids) {
      return ids is list
        && ids.size() == 6
        && ids[0] is string
        && ids[1] is string
        && ids[2] is string
        && ids[3] is string
        && ids[4] is string
        && ids[5] is string
        && ids[0] != ids[1]
        && ids[0] != ids[2]
        && ids[0] != ids[3]
        && ids[0] != ids[4]
        && ids[0] != ids[5]
        && ids[1] != ids[2]
        && ids[1] != ids[3]
        && ids[1] != ids[4]
        && ids[1] != ids[5]
        && ids[2] != ids[3]
        && ids[2] != ids[4]
        && ids[2] != ids[5]
        && ids[3] != ids[4]
        && ids[3] != ids[5]
        && ids[4] != ids[5];
    }

    match /config/admins {
      allow read: if isSignedIn();
      allow write: if false;
    }

    match /config/categoryOrder {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /config/featuredProducts {
      allow read: if true;
      allow create, update: if isAdmin()
        && request.resource.data.keys().hasOnly(['productIds', 'updatedAt'])
        && hasSixDistinctFeaturedProductIds(request.resource.data.productIds);
      allow delete: if false;
    }

    // Storefront promotion and operational settings are public, but only admins
    // can change them. This keeps client-side displays tamper-resistant.
    match /config/{document} {
      allow read: if document != 'admins';
      allow write: if isAdmin() && document != 'featuredProducts';
    }

    match /products/{productId} {
      allow read: if true;
      allow create, update, delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create: if isSignedIn() && request.auth.uid == userId
        && (!('points' in request.resource.data) || request.resource.data.points == 0)
        && !('pointsUpdatedAt' in request.resource.data)
        && (!('balanceGmd' in request.resource.data) || request.resource.data.balanceGmd == 0)
        && !('balanceUpdatedAt' in request.resource.data);
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('points', resource.data.get('points', 0)) == resource.data.get('points', 0)
        && request.resource.data.get('pointsUpdatedAt', resource.data.get('pointsUpdatedAt', null)) == resource.data.get('pointsUpdatedAt', null)
        && request.resource.data.get('balanceGmd', resource.data.get('balanceGmd', 0)) == resource.data.get('balanceGmd', 0)
        && request.resource.data.get('balanceUpdatedAt', resource.data.get('balanceUpdatedAt', null)) == resource.data.get('balanceUpdatedAt', null)
        && request.resource.data.get('accountStatus', resource.data.get('accountStatus', 'active')) == resource.data.get('accountStatus', 'active')
        && request.resource.data.get('statusUpdatedBy', resource.data.get('statusUpdatedBy', null)) == resource.data.get('statusUpdatedBy', null)
        && (resource.data.get('nameLocked', false) != true
            || (request.resource.data.get('firstName', '') == resource.data.get('firstName', '')
                && request.resource.data.get('lastName', '') == resource.data.get('lastName', '')
                && request.resource.data.get('nameLocked', false) == true))
        && (resource.data.get('ageLocked', false) != true
            || request.resource.data.get('age', 0) == resource.data.get('age', 0));
      allow delete: if false;
    }

    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid
                    && request.resource.data.name is string
                    && request.resource.data.text is string
                    && request.resource.data.rating is int
                    && request.resource.data.rating >= 1
                    && request.resource.data.rating <= 5
                    && request.resource.data.productId is string
                    && request.resource.data.productName is string
                    && request.resource.data.keys().hasOnly(['userId', 'name', 'rating', 'text', 'avatar', 'productId', 'productName', 'createdAt']);
      allow update, delete: if isSignedIn()
                              && resource.data.userId == request.auth.uid;
    }

    match /users/{userId}/orders/{orderId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /users/{userId}/wishlist/{productId} {
      allow read, delete: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.productId == productId
        && request.resource.data.keys().hasOnly(['productId', 'savedAt']);
    }

    match /users/{userId}/pointsHistory/{entryId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/promoRedemptions/{code} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /users/{userId}/pointsCodeRedemptions/{code} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow write: if false;
    }

    match /orders/{orderId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /adminActivity/{activityId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /backups/{backupId} {
      allow read: if isAdmin();
      allow write: if false;
      allow delete: if false;
    }

    match /users/{userId}/activity/{activityId} {
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.action is string
        && request.resource.data.keys().hasOnly(['action','data','createdAt']);
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow update, delete: if false;
    }

    match /promos/{promoId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /pointsCodes/{code} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /flashSales/{saleId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
